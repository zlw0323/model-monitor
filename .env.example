# 复制为 .env 后修改。不要把 .env 提交到代码仓库。

# 必填：用于会话签名和加密存储 API Key / SMTP 密码。生成方式：
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
# 部署后不要再修改，否则已保存的 Key 无法解密，需要重新填写。
SECRET_KEY=

# 必填：面板登录账号
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# 显示与邮件中使用的时区
APP_TZ=Asia/Hong_Kong

# 使用 HTTPS（Caddy）访问时设为 true
COOKIE_SECURE=false

# HTTPS 方式：填写已解析到本服务器的域名，然后 docker compose --profile https up -d
DOMAIN=

# 不用域名、直接通过 http://服务器IP:8000 访问时设为 0.0.0.0（明文传输，不推荐）
APP_BIND=127.0.0.1
